# interpreter for shell commands
set shell sh

# set '-eu' options for shell commands
# These options are used to have safer shell commands. Option '-e' is used to
# exit on error and option '-u' is used to give error for unset variables.
# Option '-f' disables pathname expansion which can be useful when $f, $fs, and
# $fx variables contain names with '*' or '?' characters. However, this option
# is used selectively within individual commands as it can be limiting at
# times.

cmd move-up-redraw :up; redraw
cmd move-down-redraw :down; redraw
cmd unselect-all :clear; unselect; visual-unselect


set shellopts '-eu'

set ifs "\n"
set scrolloff 0
set icons
set drawbox
set previewer "~/.config/lf/previewer"

set cursorpreviewfmt "\033[7;2m"

# Keybinds

map . set hidden!
map <enter> shell
map <esc> unselect-all
map A push :mkdir<space>""<left>
map a :push %touch<space>
map H cd ~
map j move-down-redraw
map k move-up-redraw
map w !true
map x cut
map r rename-vim $fx
map D delete $fx
map M &mpvq add $fx
map W &wallpaper set $fx
map E extract $fx
map i !mimetype $fx
map v visual
map V invert

# Commands

cmd open &{{
    case $(file --mime-type -Lb "$f") in
        text/*|application/json|application/mbox|application/x-shellscript|inode/x-empty|application/x-subrip) lf -remote "send $id \$$EDITOR \$fx" ;;
        image/x-xcf) gimp "$fx" ;;
        image/vnd.djvu|application/pdf|application/postscript) zathura "$fx" ;; 
        image/*) nsxiv "$fx" ;; 
        audio/*|video/x-ms-asf) mpv --audio-display=no "$f" ;;
        video/*) setsid -f mpv "$f" -quiet >/dev/null 2>&1 ;;
        application/*tar|application/*zip) lf -remote "send $id extract \$fx" ;;
        *) for f in $fx; do setsid -f $OPENER "$f" > /dev/null 2> /dev/null & done ;;
    esac
}}

cmd mkdir $mkdir -p "$@"

cmd delete ${{
    set -f
    printf "$fx\n"
    printf "delete? [y/N] "
    read ans
    [ "$ans" = "y" ] && rm -rf $fx
}}

cmd rename-vim ${{
    tmp=$(mktemp)
    
    echo "$fx" > "$tmp"
    
    $EDITOR "$tmp"
    
    paste "$tmp" -d '\n' <(echo "$fx") | while IFS= read -r newname; do
        read -r oldname
        [ -z "$newname" ] && continue
        [ "$newname" = "$oldname" ] && continue
        mv -- "$oldname" "$newname"
    done
    
    rm "$tmp"
    lf -remote "send $id unselect"
}}

cmd extract ${{
    set -f
    case $f in
        *.tar.bz|*.tar.bz2|*.tbz|*.tbz2) tar xjvf $f;;
        *.tar.gz|*.tgz) tar xzvf $f;;
        *.tar.xz|*.txz) tar xJvf $f;;
        *.zip) unzip $f;;
        *.rar) unrar x $f;;
        *.7z) 7z x $f;;
    esac
}}

source "~/.config/lf/shortcutsrc"


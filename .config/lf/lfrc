# interpreter for shell commands
set shell sh

# set '-eu' options for shell commands
# These options are used to have safer shell commands. Option '-e' is used to
# exit on error and option '-u' is used to give error for unset variables.
# Option '-f' disables pathname expansion which can be useful when $f, $fs, and
# $fx variables contain names with '*' or '?' characters. However, this option
# is used selectively within individual commands as it can be limiting at
# times.

set shellopts '-eu'

set ifs "\n"
set scrolloff 0
set icons
set drawbox
set previewer "~/.config/lf/previewer"
set cleaner "~/.config/lf/cleaner"
set mouse

set cursorpreviewfmt "\033[7;2m"

# Keybinds

map . set hidden!
map <enter> shell
map <esc> unselect-all
map A push :mkdir<space>""<left>
map a push :mkfile<space>""<left>
map H cd ~
map w !true
map x cut
map D delete $fx
map B bulkrename
map R rename-vim
map M &for f in $fx; do mpvq add $f; done
map W &wallpaper set $fx
map E extract $fx
map i !xdg-mime query filetype $fx
map o &mimeopen $fx
map O $mimeopen --ask $fx

map r
map rA :rename; cmd-end # change ext
map ra :rename; cmd-right # after .
# map rr push A<c-u> # replace
map rr :rename; cmd-home; cmd-delete-end
map rI :rename; cmd-home # rename at start
map ri :rename # rename before .

# Commands

cmd open &{{
    case $(xdg-mime query filetype "$f") in
        text/*|application/xml|application/javascript|application/toml|application/typescript|application/x-desktop|application/x-troff-man|application/json|application/mbox|application/x-shellscript|inode/x-empty|application/x-subrip|audio/x-mod|inode/symlink|application/x-wine-extension-ini) lf -remote "send $id \$$EDITOR \$fx" ;;
        image/x-xcf) gimp "$fx" ;;
        image/vnd.djvu*|application/pdf|application/postscript) zathura "$fx" ;; 
        image/*) nsxiv "$fx" ;; 
        audio/*ogg) setsid -f $TERMINAL -e mpv "$fx" ;;
        audio/*|video/x-ms-asf|video/*) setsid -f mpv "$fx" -quiet >/dev/null 2>&1 ;;
        application/*rar|application/*tar|application/gzip|application/zip|application/x-7z-compressed|application/x-xz) lf -remote "send $id extract \$fx" ;;
        *) for f in $fx; do setsid -f $OPENER "$f" > /dev/null 2> /dev/null & done ;;
    esac
}}

cmd mkdir $mkdir -p "$@"
cmd mkfile $touch "$@"
cmd unselect-all :clear; unselect; visual-unselect

cmd delete ${{
    for f in $fx; do
        printf "%s\n" "$f"
    done
    printf "delete? [y/N] "
    read ans
    [ "$ans" = "y" ] && for f in $fx; do rm -rf -- "$f"; done
}}

cmd rename-vim ${{
    set -e

    tmp_old="$(mktemp)"
    tmp_new="$(mktemp)"
    trap 'rm -f "$tmp_old" "$tmp_new"' EXIT

    printf '%s\n' "$fx" > "$tmp_old"

    sed 's:.*/::' "$tmp_old" > "$tmp_new"

    ${EDITOR:-nvim} "$tmp_new"

    paste "$tmp_old" "$tmp_new" | while IFS="$(printf '\t')" read -r old new; do
        [ -z "$new" ] && continue

        old_base="$(basename -- "$old")"
        [ "$old_base" = "$new" ] && continue

        dir="$(dirname -- "$old")"
        mv -- "$old" "$dir/$new"
    done
}}

cmd bulkrename ${{
    tmpfile_old="$(mktemp)"
    tmpfile_new="$(mktemp)"

    [ -n "$fs" ] && fs=$(basename -a $fs) || fs=$(ls)

    echo "$fs" > "$tmpfile_old"
    echo "$fs" > "$tmpfile_new"
    $EDITOR "$tmpfile_new"

    [ "$(wc -l < "$tmpfile_old")" -eq "$(wc -l < "$tmpfile_new")" ] || { rm -f "$tmpfile_old" "$tmpfile_new"; exit 1; }

    paste "$tmpfile_old" "$tmpfile_new" | while IFS="$(printf '\t')" read -r src dst
    do
        [ "$src" = "$dst" ] || [ -e "$dst" ] || mv -- "$src" "$dst"
    done

    rm -f "$tmpfile_old" "$tmpfile_new"
    lf -remote "send $id unselect"
}}

cmd extract ${{
    set -f
    case $f in
        *.tar.bz|*.tar.bz2|*.tbz|*.tbz2) tar xjvf $f;;
        *.tar.gz|*.tgz) tar xzvf $f;;
        *.tar.xz|*.txz) tar xJvf $f;;
        *.zip) unzip $f;;
        *.rar) unrar x $f;;
        *.7z) 7z x $f;;
    esac
}}

source "~/.config/lf/shortcutsrc"


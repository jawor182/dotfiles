set statusbar-h-padding 2
set statusbar-v-padding 2
set page-v-padding 2
set page-h-padding 2
set selection-clipboard clipboard
set font "JetBrainsMonoNerdFont 12"
set adjust-open "best-fit"
set statusbar-bg "#282828"
set statusbar-fg "#ebdbb2"
set default-bg "#282828"
set default-fg "#ebdbb2"
unmap =
unmap +
map u scroll half-up
map d scroll half-down
map D toggle_page_mode
map r reload
map R rotate
map i recolor
map p print
map g goto top
map b toggle_statusbar
map = zoom in
map I zoom in
map O zoom out
map + zoom original
map [fullscreen] u scroll half-up
map [fullscreen] d scroll half-down
map [fullscreen] D toggle_page_mode
map [fullscreen] r reload
map [fullscreen] R rotate
map [fullscreen] = zoom in 
map [fullscreen] I zoom in 
map [fullscreen] O zoom out 
map [fullscreen] + zoom original 
map [fullscreen] i recolor
map [fullscreen] p print
map [fullscreen] g goto top
map [fullscreen] b toggle_statusbar

# Font for window titles. Will also be used by the bar unless a different font
# is used in the bar {} block below.
font pango:JetBrainsMonoNerd 12

# Start XDG autostart .desktop files using dex. See also
# https://wiki.archlinux.org/index.php/XDG_Autostart
exec --no-startup-id dex --autostart --environment i3

# The combination of xss-lock, nm-applet and pactl is a popular choice, so
# they are included here as an example. Modify as you see fit.


set $refresh_volume pkill -RTMIN+9 i3blocks
set $refresh_brightness pkill -RTMIN+11 i3blocks

# Audio Controls
bindsym XF86AudioRaiseVolume exec --no-startup-id wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+ && $refresh_volume
bindsym XF86AudioLowerVolume exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- && $refresh_volume
bindsym XF86AudioMute        exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle && $refresh_volume
bindsym XF86AudioMicMute     exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle && $refresh_volume

bindsym XF86MonBrightnessUp   exec --no-startup-id brightnessctl s 10%+ && $refresh_brightness
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl s 10%- && $refresh_brightness

bindsym XF86AudioNext  exec --no-startup-id playerctl next && pkill -RTMIN+3 i3blocks
bindsym XF86AudioPause exec --no-startup-id playerctl play-pause && pkill -RTMIN+3 i3blocks
bindsym XF86AudioPlay  exec --no-startup-id playerctl play-pause && pkill -RTMIN+3 i3blocks
bindsym XF86AudioPrev  exec --no-startup-id playerctl previous && pkill -RTMIN+3 i3blocks

set $mod Mod4

set $left h
set $down j
set $up k
set $right l

set $menu dmenu_run
set $browser brave
set $email thunderbird
set $passwords keepassxc
set $lockscreen i3slock
set $wallpaper wallpaper open
set $randWallpaper wallpaper random
set $communicator discord
set $books calibre
set $guifiles pcmanfm-qt

gaps inner 4
gaps outer 4
focus_wrapping workspace
smart_gaps on
# Do u want title bar or just 4px border?
# default_border pixel 4

# use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

# move tiling windows via drag & drop by left-clicking into the title bar,
# or left-clicking anywhere into the window while holding the floating modifier.
tiling_drag modifier titlebar

bindsym $mod+d exec --no-startup-id $menu
bindsym $mod+Return exec --no-startup-id st
bindsym $mod+w exec --no-startup-id $browser
bindsym $mod+e exec --no-startup-id $email
bindsym $mod+p exec --no-startup-id $passwords
bindsym $mod+Escape exec --no-startup-id $lockscreen
bindsym $mod+f exec --no-startup-id st -e lfub
bindsym $mod+Shift+n exec --no-startup-id st -e newsraft
bindsym $mod+Mod1+f exec --no-startup-id $guifiles
bindsym $mod+n exec --no-startup-id st -T notes -e sh -c "cd $HOME/dox/notes && $EDITOR"
bindsym $mod+shift+w exec --no-startup-id $wallpaper
bindsym $mod+Control+w exec --no-startup-id $randWallpaper
bindsym $mod+Shift+c exec --no-startup-id $communicator
bindsym $mod+shift+b exec --no-startup-id $books

bindsym $mod+Mod1+p exec playerctl -p mpd play-pause && $refresh_blocks
bindsym $mod+Mod1+s exec playerctl -p mpd pause && playerctl -p mpd position 0 && $refresh_blocks
bindsym $mod+Mod1+period exec playerctl -p mpd next && $refresh_blocks
bindsym $mod+Mod1+comma exec playerctl -p mpd previous && $refresh_blocks
bindsym $mod+Mod1+equal exec playerctl -p mpd volume 0.05+ && $refresh_blocks
bindsym $mod+Mod1+minus exec playerctl -p mpd volume 0.05- && $refresh_blocks

bindsym $mod+Shift+s exec screenshot
bindsym Print exec screenshot
bindsym $mod+Shift+u exec dmenuunicode
bindsym $mod+Shift+p exec colorpicker
bindsym $mod+Shift+Escape exec powermenu
bindsym $mod+Shift+m exec mpvq play
bindsym $mod+Shift+a exec mpvq addclip
bindsym $mod+Shift+grave exec dmenubookmarks select_browser
bindsym $mod+grave exec dmenubookmarks select
bindsym $mod+Mod1+b exec dmenubookmarks add
bindsym $mod+c move position center

# Rules
assign [class="mpv"] output HDMI-0
assign [class="org.mozilla.Thunderbird"] 3
assign [class="KeePassXC"] 9
assign [class="qBittorrent"] 7
assign [class="calibre-gui"] 4
assign [class="discord"] 14
assign [title="newsraft"] 5
for_window [class="floatingTerm"] floating enable
for_window [class=".*"] border normal 4

exec --no-startup-id st -T spterm
exec --no-startup-id st -T spmusic -e rmpc

for_window [title="spterm"] floating enable, resize set 60 ppt 70 ppt, move position center, move scratchpad
bindsym $mod+Shift+Return exec --no-startup-id i3-msg '[title="spterm"] scratchpad show' || ( st -T spterm && sleep 0.1 && xdotool key --clearmodifiers super+shift+Return )

for_window [title="spmusic"] floating enable, resize set 60 ppt 70 ppt, move position center, move scratchpad
bindsym $mod+m exec --no-startup-id i3-msg '[title="spmusic"] scratchpad show' || ( st -T spmusic -e rmpc && sleep 0.1 && xdotool key super+m )

# kill focused window
bindsym $mod+q kill

# change focus
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right

# move focused window
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right

# split in horizontal orientation
bindsym $mod+b split h

# split in vertical orientation
bindsym $mod+v split v

# enter fullscreen mode for the focused container
bindsym $mod+Shift+f fullscreen toggle

# change container layout (stacked, tabbed, toggle split)
bindsym $mod+Control+s layout stacking
bindsym $mod+Control+t layout tabbed
bindsym $mod+Control+e layout toggle split

# toggle tiling / floating
bindsym $mod+Shift+space floating toggle

# change focus between tiling / floating windows
bindsym $mod+space focus mode_toggle

# focus the parent container
bindsym $mod+a focus parent
#bindsym $mod+d focus child

workspace 1 output eDP-0
workspace 2 output eDP-0
workspace 4 output eDP-0
workspace 5 output eDP-0
workspace 6 output eDP-0
workspace 7 output eDP-0
workspace 8 output eDP-0
workspace 9 output eDP-0
workspace 10 output eDP-0

workspace 1 output DP-0
workspace 2 output DP-0
workspace 3 output DP-0
workspace 4 output DP-0
workspace 5 output DP-0
workspace 6 output DP-0
workspace 7 output DP-0
workspace 8 output DP-0
workspace 9 output DP-0
workspace 10 output DP-0

workspace 11 output HDMI-0
workspace 12 output HDMI-0
workspace 13 output HDMI-0
workspace 14 output HDMI-0
workspace 15 output HDMI-0
workspace 16 output HDMI-0
workspace 17 output HDMI-0
workspace 18 output HDMI-0
workspace 19 output HDMI-0
workspace 20 output HDMI-0

# switch to workspace
bindsym $mod+1 exec --no-startup-id ~/.local/bin/i3-workspace 1
bindsym $mod+2 exec --no-startup-id ~/.local/bin/i3-workspace 2
bindsym $mod+3 exec --no-startup-id ~/.local/bin/i3-workspace 3
bindsym $mod+4 exec --no-startup-id ~/.local/bin/i3-workspace 4
bindsym $mod+5 exec --no-startup-id ~/.local/bin/i3-workspace 5
bindsym $mod+6 exec --no-startup-id ~/.local/bin/i3-workspace 6
bindsym $mod+7 exec --no-startup-id ~/.local/bin/i3-workspace 7
bindsym $mod+8 exec --no-startup-id ~/.local/bin/i3-workspace 8
bindsym $mod+9 exec --no-startup-id ~/.local/bin/i3-workspace 9
bindsym $mod+0 exec --no-startup-id ~/.local/bin/i3-workspace 10

# move focused container to workspace
bindsym $mod+Shift+1 exec --no-startup-id ~/.local/bin/i3-workspace-move 1
bindsym $mod+Shift+2 exec --no-startup-id ~/.local/bin/i3-workspace-move 2
bindsym $mod+Shift+3 exec --no-startup-id ~/.local/bin/i3-workspace-move 3
bindsym $mod+Shift+4 exec --no-startup-id ~/.local/bin/i3-workspace-move 4
bindsym $mod+Shift+5 exec --no-startup-id ~/.local/bin/i3-workspace-move 5
bindsym $mod+Shift+6 exec --no-startup-id ~/.local/bin/i3-workspace-move 6
bindsym $mod+Shift+7 exec --no-startup-id ~/.local/bin/i3-workspace-move 7
bindsym $mod+Shift+8 exec --no-startup-id ~/.local/bin/i3-workspace-move 8
bindsym $mod+Shift+9 exec --no-startup-id ~/.local/bin/i3-workspace-move 9
bindsym $mod+Shift+0 exec --no-startup-id ~/.local/bin/i3-workspace-move 10

bindsym $mod+comma focus output left
bindsym $mod+period focus output right
bindsym $mod+Shift+comma move output left
bindsym $mod+Shift+period move output right

bindsym $mod+r reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+q exit


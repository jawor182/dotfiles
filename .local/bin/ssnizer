#!/bin/sh

selected=$(find "$HOME/repos/projects" -mindepth 1 -maxdepth 2 -path "*/.git*" -prune -o -type d -print | fzf --height=100%)

if [ -z "$selected" ]; then
    exit 1
fi

name=$(basename "$selected")

if ! tmux has-session -t "$name" 2>/dev/null; then
    tmux new-session -d -s "$name" -c "$selected"

    tmux new-window -t "$name":2 -c "$selected"
    tmux send-keys -t "$name":1.1 "nvim" C-m
    tmux select-window -t "$name":1
fi

if [ -z "$TMUX" ]; then
    tmux attach-session -t "$name"
else
    tmux switch-client -t "$name"
fi

#!/bin/sh

bmfile=$HOME/keepassxc/bookmarks

selectbookmark() {
    selected=$(cat "$bmfile" | dmenu -d -i -l 10 -p "Select bookmark:"| cut -d ' ' -f 1)
    [ -z "$selected" ] && exit
    echo -n "$selected" | xclip -selection clipboard
}

selectbookmark_browser() {
    selected=$(cat "$bmfile" | dmenu -d -i -l 10 -p "Select bookmark:"| cut -d ' ' -f 1)
    [ -z "$selected" ] && exit
    $BROWSER "$selected"
}

addbookmark(){
    bookmark=$(xclip -o)
    if sed 's/ *#.*//' "$bmfile" | grep -x "$bookmark"; then
        notify-send "Bookmark is already in file"
        exit 1
    fi
    printf '%s\n' "$bookmark" >> "$bmfile"
    xclip -selection clipboard /dev/null
    notify-send "Added to bookmarks" "$bookmark"
}

case "$1" in
    select) selectbookmark;;
    select_browser) selectbookmark_browser;;
    add) addbookmark;;
esac

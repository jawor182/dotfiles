#!/bin/sh

TREE=$(mmsg get all-clients | jq -r '.clients[] | select (.is_visible)')
SELECTION=$(echo $TREE | jq -r '. | "\(.x),\(.y) \(.width)x\(.height)"' | slurp)

[ ! -n "$SELECTION" ] && printf "%s\n" "Nothing has been selected" && exit 1

X=$(echo $SELECTION | awk -F'[, x]' '{print $1}')
Y=$(echo $SELECTION | awk -F'[, x]' '{print $2}')
W=$(echo $SELECTION | awk -F'[, x]' '{print $3}')
H=$(echo $SELECTION | awk -F'[, x]' '{print $4}')

echo "$TREE" | jq -r --argjson x $X --argjson y $Y --argjson w $W --argjson h $H '. | select(.x == $x and .y == $y and .width == $w and .height == $h)'

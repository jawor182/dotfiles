#!/bin/sh

randomWall=$(find "$HOME/walls" -type f -iname "*.png" -print0 | shuf -n 1 -z)

case "$1" in
"random")
    if [ "$XDG_SESSION_TYPE" = "x11" ]; then
        xwallpaper --stretch "$randomWall"
    else
        swaybg -m stretch -i "$randomWall"
    fi
    ;;
"set")
    target="$2"

    if [ -d "$target" ]; then
        wall=$(find "$target" -type f -iname "*.png" -print0 | shuf -n 1 -z)
    else
        wall="$target"
    fi

    if [ "$XDG_SESSION_TYPE" = "x11" ]; then
        xwallpaper --stretch "$wall"
    else
        swaybg -m stretch -i "$wall"
    fi
    ;;
"open")
    find "$HOME/walls" -type f -iname '*.png' | shuf | nsxiv -tb -
    ;;
esac

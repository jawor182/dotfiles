#!/bin/sh

tsp yt-dlp -f "bestvideo[height<=1080]+bestaudio/best[height<=1080]" --remote-components ejs:github --cookies-from-browser brave --merge-output-format mkv --write-thumbnail --convert-thumbnails jpg --embed-thumbnail --add-metadata --extractor-args "youtube:player_js_version=actual" -o "$HOME/media/vids/%(title)s.%(ext)s" --exec "rm %(thumbnails.-1.filepath)q" "$1"

#!/bin/sh

targetDir="/backup"
currentDate=$(date "+%F")
backupFile="backup-$currentDate.tar.gz"
outputFile="$targetDir/$backupFile"

[ ! -d "$targetDir" ] && echo "Could not find target directory" && exit 1
[ -f "$outputFile" ] && echo "Backup for today ($currentDate) already exists" && exit 1

echo "🔄 Starting backup: $outputFile"

if tar -czvf "$outputFile" \
    --exclude="$HOME/dox/ISO" \
    --exclude="$HOME/dox/games" \
    "$HOME/dox" \
    "$HOME/repos" \
    "$HOME/keepassxc" \
    "$HOME/dotfiles" \
    "$HOME/.ssh"
then
    echo "✅ Backup completed successfully!"
    echo "📦 Saved to: $outputFile"
else
    echo "❌ Backup failed!"
    exit 1
fi

#!/bin/sh

KEY="$1"

# Get focused workspace name
FOCUSED_WS=$(i3-msg -t get_workspaces | jq -r '.[] | select(.focused==true).name')

# Get output for that workspace
FOCUSED_OUTPUT=$(i3-msg -t get_outputs | jq -r \
  --arg ws "$FOCUSED_WS" \
  '.[] | select(.current_workspace==$ws).name')

case "$FOCUSED_OUTPUT" in
    HDMI-*)
        WS="$((KEY + 10))"
        ;;
    *)
        WS="$KEY"
        ;;
esac

exec i3-msg "move container to workspace number $WS"

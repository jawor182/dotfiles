#!/bin/sh

export TERMINAL=foot
export XCURSOR_SIZE=24
export XCURSOR_THEME=breeze_cursors
export QT_QPA_PLATFORMTHEME=gtk3
export QT_QPA_PLATFORM=wayland
export QT_SCALE_FACTOR=1
export GTK_THEME=adw-gtk3-dark
export XDG_CONFIG_HOME="$HOME/.config/"
export XDG_CURRENT_DESKTOP=dwl
export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=dwl
export BEMENU_OPTS="--fn 'JetBrainsMonoNerdFont 16' -H 30 -i -p '' --hp 8 --fb '#282828' --ff '#ebdbb2' --nb '#282828' --nf '#ebdbb2' --tb '#d65d0e' --tf '#282828' --hf '#282828' --hb '#d65d0e' --nf '#ebdbb2' --af '#ebdbb2' --ab '#282828'"

dbus-update-activation-environment --all
dbus-launch ssh-agent

exec someblocks -p | dwl -s "$HOME/.local/bin/dwl-autostart"
